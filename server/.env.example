# =============================================================================
#  LRC-401 API — environment template
# =============================================================================
#  Copy this file to `.env` and fill in real values:
#
#      cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
#  `.env` is git-ignored. NEVER commit real secrets.
#  Every variable below is validated at boot by src/config/env.js — the server
#  refuses to start with a missing or weak secret rather than running insecurely.
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the React app. Used for CORS and for links inside emails.
CLIENT_URL=http://localhost:5173

# --- Database ----------------------------------------------------------------
# Local PostgreSQL 16. Create the database once with:
#     psql -U postgres -c "CREATE DATABASE lrc401;"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lrc401?schema=public"

# --- Secrets -----------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They must be DIFFERENT from each other: if one leaks, the others still hold.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_32
# Signs the short-lived token issued between "password OK" and "2FA code OK".
JWT_MFA_SECRET=replace_me_with_a_third_long_random_string_32chars

# AES-256-GCM key encrypting TOTP secrets at rest — EXACTLY 64 hex chars (32 bytes).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this makes every existing 2FA enrolment unreadable.
TOTP_ENC_KEY=replace_me_with_exactly_64_hexadecimal_characters_0000000000000000

# --- Token lifetimes ---------------------------------------------------------
# Short access token limits the damage window if one is ever captured.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MFA_TOKEN_TTL=5m
INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60

# --- Brute-force protection --------------------------------------------------
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# --- Email -------------------------------------------------------------------
# Leave EMAIL_TRANSPORT=console during development: emails are printed to the
# terminal (with the invite link) instead of being sent. No account needed.
#   console | smtp
EMAIL_TRANSPORT=console
EMAIL_FROM="LRC Saida 401 <no-reply@lrc401.org>"
# Only needed when EMAIL_TRANSPORT=smtp. Brevo free tier = 300 emails/day.
# Check delivery with:  npm --prefix server run email:test -- you@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# true ONLY for port 465. Port 587 upgrades with STARTTLS and needs false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
#
# Gmail (fine for a demo, see docs/08-DEPLOYMENT.md):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com    SMTP_PASS=<16-char App Password, not your Google password>
#   EMAIL_FROM="LRC Saida 401 <you@gmail.com>"   (must be the same Gmail address)

# --- Hosting -------------------------------------------------------------------
# true = this process also serves the built web app (client/dist), so the app
# and the API share one origin. Leave false in development (Vite serves it).
SERVE_CLIENT=false

# --- First super admin -------------------------------------------------------
# Used ONLY by `npm run db:seed`, and only when the account does not already
# exist. Editing these AFTER seeding changes nothing — the seed never overwrites
# an existing account's password. To change an existing one, use:
#
#     npm run set-password -- <email> '<newPassword>'
#
# SEED_SUPERADMIN_EMAIL must be a valid EMAIL ADDRESS. A bare word such as
# "admin" fails validation and the server will refuse to start: email is the
# identity in this system (invitations, password resets and 2FA all key on it).
#
# SEED_SUPERADMIN_PASSWORD must meet the real policy: 10+ characters, with an
# uppercase letter, a lowercase letter and a number.
SEED_SUPERADMIN_EMAIL=admin@lrc401.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026
SEED_SUPERADMIN_NAME=Station Super Admin

# --- Logging -----------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=debug
